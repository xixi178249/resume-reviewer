# 复制本文件为 .env，填入你自己的 key
# .env 已在 .gitignore 里，不会被提交

# ---- 必填 ----
DSH_LLM_API_KEY=sk-在这里填你的key

# ---- 可选（不填就用默认值）----
# 默认 deepseek-chat
DSH_LLM_MODEL=deepseek-chat
# 默认 https://api.deepseek.com/v1  （注意要带 /v1）
DSH_LLM_BASE_URL=https://api.deepseek.com/v1

# 思考开关：off = 不跑 CoT，约 15 秒出结果；on = 跑满 CoT，一份要 5~10 分钟（容易超时）
# 推理型模型（deepseek-flash / deepseek-v4-pro）建议 off，质量靠 prompt + 校验器兜
DSH_LLM_THINKING=off
# 单次模型调用超时（秒）
DSH_LLM_TIMEOUT=300

# ---- 备选服务商示例 ----
# 硅基流动： DSH_LLM_BASE_URL=https://api.siliconflow.cn/v1
# 阿里通义： DSH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 vLLM：DSH_LLM_BASE_URL=http://127.0.0.1:8000/v1
